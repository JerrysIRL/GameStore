@page "/Login"
@using GameStore.Frontend.User
@using Microsoft.AspNetCore.Identity

@inject NavigationManager NavigationManager
@inject SignInManager<GameStoreUser> SignInManager
@inject ILogger<Login> Logger


<PageTitle>Login</PageTitle>


@if (UserDetails is null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <section>
        <div class="container-fluid h-custom">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-md-9 col-lg-6 col-xl-5">
                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.webp"
                         class="img-fluid" alt="Sample image">
                </div>
                <div class="col-md-8 col-lg-6 col-xl-4 offset-xl-1 mt-5">
                    <h3 style="color: #e50000">@_warningText</h3>
                    <EditForm Model="@UserDetails" FormName="login" method="post" OnValidSubmit="HandleLoginAsync">
                        <DataAnnotationsValidator/>
                        <!-- Email input -->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <InputText
                                @bind-Value="UserDetails.Email"
                                id="form3Example3"
                                class="form-control form-control-lg"
                                placeholder="Enter a valid email address">
                            </InputText>
                            <label class="form-label" for="form3Example3">Email address</label>
                            <ValidationMessage For=" () => UserDetails.Email"/>
                        </div>

                        <!-- Password input -->
                        <div data-mdb-input-init class="form-outline mb-3">
                            <InputText
                                @bind-Value="UserDetails.Password"
                                type="password"
                                id="form3Example4"
                                class="form-control form-control-lg"
                                placeholder="Enter password">
                            </InputText>
                            <label class="form-label" for="form3Example4">Password</label>
                            <ValidationMessage For=" () => UserDetails.Password"/>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <!-- Checkbox -->
                            <div class="form-check mb-0">
                                <input class="form-check-input me-2" type="checkbox" value="" id="form2Example3"/>
                                <label class="form-check-label" for="form2Example3">
                                    Remember me
                                </label>
                            </div>
                            <a href="#!" class="text-body">Forgot password?</a>
                        </div>

                        <div class="text-center text-lg-start mt-4 pt-2">
                            <button type="submit"
                                    class="btn btn-primary btn-lg"
                                    style="padding-left: 2.5rem; padding-right: 2.5rem;">
                                Login
                            </button>
                            <p class="small fw-bold mt-2 pt-1 mb-0">
                                Don't have an account?
                                <a href="/register"
                                   class="link-danger">
                                    Register
                                </a>
                            </p>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </section>
}

@code {

    [SupplyParameterFromForm] UserDetails UserDetails { get; set; } = new();
    string _warningText = "";

    private async Task HandleLoginAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(UserDetails.Email, UserDetails.Password, isPersistent: false, lockoutOnFailure: false);
        Logger.LogInformation(result.IsNotAllowed.ToString());
        if (result.Succeeded)
        {
            Logger.LogInformation($"{UserDetails.Email} logged in successfully.");
            NavigationManager.NavigateTo("/");
        }
        else
        {
            _warningText = "Invalid email or password.";
            Logger.LogWarning($"{UserDetails.Email} failed to log in.");
        }
    }

}